# Abhängigkeiten
node_modules/

# Umgebung & Geheimnisse
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Betriebssystem / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build-Ausgabe
dist/
build/

# Claude Code — lokale Berechtigungen. Nicht auf die globale Ignore-Regel verlassen:
# das Repo muss für sich allein ausreichen, sonst leckt die Datei bei jedem Klon.
.claude/settings.local.json

# Projektgedächtnis — die Sitzungsbrücke bleibt lokal,
# die Entscheidungs- und Regelschicht wird committet.
.gehirn/letzte-sitzung.md

# Traces — je Lauf eine JSONL-Datei (EVALS.md §6). Lokal das Werkzeug zur
# Ursachensuche, im Repo Ballast. Committet wird nur, was als Beispiel dient.
evals/traces/*
!evals/traces/samples/

# Menschliche, türkischsprachige Projektdarstellung — richtet sich an die
# Nutzerin/den Nutzer, nicht an die Öffentlichkeit. Vertragsdokumente
# (PRODUCT/ARCHITECTURE/DECISIONS/EVALS, docs/) bleiben öffentlich.
CLAUDE-CODE-BRIEFING.md
documentation.md
