# Kopyala: cp .env.example .env  ve doldur.

# Anthropic API anahtari. BOS BIRAKIRSAN sistem "mock" modda calisir:
# gercek LLM cagrisi yapilmaz, deterministik sahte cevaplar uretilir.
# Boylece API anahtari olmadan da tum akisi (graph + HITL + guvenlik) test edebilirsin.
ANTHROPIC_API_KEY=

# Tum LLM ajanlari icin tek model (referans sistemdeki gibi).
MODEL=claude-sonnet-4-6

# Panel/istemci kimligi. Production'da fail-closed: bilinmeyen key 401.
API_KEY=dev-local-key

# Aylik bütçe tavani (USD). Asilirsa kill-switch devreye girer.
MONTHLY_BUDGET_USD=5

PORT=3000
