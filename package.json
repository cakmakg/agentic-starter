{
  "name": "agentic-starter",
  "version": "1.0.0",
  "description": "Sifirdan agentic sistem icin yeniden-kullanilabilir starter.",
  "type": "module",
  "main": "src/bin/serve.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/bin/serve.js",
    "dev": "node --watch src/bin/serve.js",
    "demo": "node src/bin/demo.js",
    "demo:immobilien": "node src/bin/demoImmobilien.js",
    "test": "node --test --test-force-exit --experimental-test-coverage --test-coverage-lines=80 --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=src/adapters/http/server.js --test-coverage-exclude=src/bin/*.js --test-coverage-exclude=\"vendor/**\" \"tests/**/*.test.js\"",
    "evals": "node evals/runners/policy.js",
    "evals:quality": "node evals/runners/quality.js"
  },
  "dependencies": {
    "@langchain/anthropic": "0.3.24",
    "@langchain/core": "0.3.66",
    "@langchain/langgraph": "0.2.74",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "zod": "3.23.8"
  },
  "overrides": {
    "@langchain/core": "0.3.66"
  }
}
